{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    /* page.evaluate() callbacks run in the browser, so e2e specs need DOM types too. */
    "lib": ["ES2023", "DOM"],
    /* Playwright transpiles specs itself and resolves extensionless imports. */
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": ["e2e"]
}
